# ============================================================================
# ChatBot Punto A — Configuración de Textos UI Personalizables
# ============================================================================
# Copie este archivo como .env y modifique los valores según sus necesidades.
# Todos estos campos son opcionales. Si no se definen, se usarán los valores por defecto.
#
# Uso: Cada variable aquí sobrescribe el texto correspondiente en la interfaz.
# ============================================================================

# TITULOS PRINCIPALES
APP_TITLE=ChatBot Punto A
APP_SUBTITLE=Chatbot WhatsApp con IA Local
APP_DESCRIPTION=Todo corre en tu servidor. Sin nube. Sin costos mensuales.

# VENTANA DEL INSTALADOR
INSTALLER_TITLE=ChatBot Punto A — Instalador de Chatbot IA Local
HARDWARE_TITLE=Hardware detectado
CONFIG_TITLE=Configuración del chatbot
CONFIG_TITLE_BUTTONS=Configuración del chatbot:

# CAMPOS DEL FORMULARIO
EMPRESA_LABEL=Nombre de la empresa:
EMPRESA_PLACEHOLDER=Ej: Mi Empresa SRL
TRAFICO_LABEL=Tráfico diario estimado (chats/día):
TRAFICO_PLACEHOLDER=Ej: 50
TRAFICO_HELP=← Se usa para calcular los tiempos de respuesta que ve el cliente

# WHATSAPP
WHATSAPP_LABEL=WhatsApp:
WHATSAPP_BTN=Vincular WhatsApp (QR)
WHATSAPP_LINKED=🟢 Vinculado
WHATSAPP_NOT_LINKED=⚪ Sin vincular

# BOTONES DE CONFIGURACION
BTN_CONVERSACIONES=💬 Conversaciones
BTN_CONFIG_A1=🔘 Menú A1
BTN_CONFIG_A2=🤖 IA A2
BTN_CONFIG_A3=🎫 Tickets A3

# BOTONES
INSTALL_BTN=Instalar ChatBot Punto A
INSTALLING=Instalando...

# VENTANA QR
QR_WINDOW_TITLE=Vincular WhatsApp — Escaneá el QR
QR_WINDOW_TITLE2=Vinculá tu WhatsApp
QR_INSTRUCTIONS=Abrí WhatsApp en tu celular → Dispositivos vinculados → Vincular dispositivo
QR_LOADING=Cargando QR...
QR_WAITING=⏳ Esperando QR de WhatsApp...
QR_READY=📲 Escaneá el código QR con tu celular
QR_CONNECTED=✅ WhatsApp vinculado correctamente
QR_ERROR_CONNECTION=⚠️ Evolution API no disponible. Verificá que la instalación esté completa.
QR_REFRESH=Refrescar QR
QR_CLOSE=Cerrar

# ============================================================================
# EJEMPLO: Personalizar para un negocio específico
# ============================================================================
# APP_TITLE=Sistema de Support - Empresa XYZ
# APP_SUBTITLE=Sistema de soporte automatizado para WhatsApp
# EMPRESA_LABEL=Nombre de tu empresa:
# CONFIG_TITLE=Configuración de tu Sistema de Soporte
