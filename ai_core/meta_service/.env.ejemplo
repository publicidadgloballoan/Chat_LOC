# ============================================================
# SaaSIA — Meta Service Local  —  Variables de Entorno
# ============================================================
# Copiar como .env y completar los valores

# Puerto del servicio (no cambiar, es el mismo que usaba Baileys)
PORT=8080

# Clave interna de autenticación (debe coincidir con backend y nucleo)
AUTHENTICATION_API_KEY=PICE-SAAS-DEFAULT-KEY-2026

# URL WebSocket del relay público
# ⚠️  CAMBIAR por tu dominio real una vez configurado Cloudflare
META_RELAY_WS=wss://relay.smart-box.com.ar/ws

# Misma clave que usa el relay para autenticar instancias
RELAY_API_KEY=PICE-SAAS-DEFAULT-KEY-2026

# URL del webhook interno del nucleo IA
NUCLEO_WEBHOOK_URL=http://localhost:5000/webhook

# Versión de la Graph API de Meta (no cambiar salvo que Meta deprece)
META_GRAPH_VERSION=v20.0
