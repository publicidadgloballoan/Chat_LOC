generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client-v2"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SaaSCompany {
  id             Int       @id @default(autoincrement())
  businessName   String    @map("business_name")
  legalName      String?   @map("legal_name")
  taxId          String    @unique @map("tax_id")
  taxType        String?   @map("tax_type")
  brandManualUrl String?   @map("brand_manual_url")
  phones         String?   @map("phones")
  website        String?   @map("website")
  emails         String?   @map("emails")
  licenseToken   String?   @map("license_token")
  createdAt      DateTime  @default(now()) @map("created_at")
  agents         SAAgent[]
  channels       Channel[]

  @@map("companies")
}

model SAAgent {
  id                Int         @id @default(autoincrement())
  companyId         Int         @map("company_id")
  name              String
  email             String      @unique
  passwordHash      String      @map("password_hash")
  phone             String?     @map("phone")
  role              String      @default("agente")
  registrationToken String?     @map("registration_token")
  status            String      @default("active")
  createdAt         DateTime    @default(now()) @map("created_at")
  company      SaaSCompany @relation(fields: [companyId], references: [id])
  tickets      Ticket[]

  @@map("agents")
}

model Channel {
  id            Int         @id @default(autoincrement())
  companyId     Int         @map("company_id")
  platform      String
  botName       String      @map("bot_name")
  instanceName  String      @unique @map("instance_name")
  configA1      Json?       @map("config_a1")
  configA2      Json?       @map("config_a2")
  configA3      Json?       @map("config_a3")
  debugMode     Json?       @map("debug_mode")
  swarmRole     String      @default("standalone") @map("swarm_role")
  parentId      Int?        @map("parent_id")
  loadCount     Int         @default(0) @map("load_count")
  status        String      @default("disconnected")
  createdAt     DateTime    @default(now()) @map("created_at")
  credentials     Json?           @map("credentials")
  company         SaaSCompany     @relation(fields: [companyId], references: [id])
  knowledgeBase   Knowledge[]
  tickets         Ticket[]
  stocks          ProductStock[]
  pricing         PricingConfig[]
  identity        CompanyIdentity?
  logistics       LogisticsConfig?

  @@map("channels")
}

model Knowledge {
  id              Int      @id @default(autoincrement())
  channelId       Int      @map("channel_id")
  fileName        String   @map("file_name")
  filePath        String   @map("file_path")
  fileType        String?  @map("file_type")
  embeddingStatus String   @default("pending") @map("embedding_status")
  lastUpdated     DateTime @default(now()) @map("last_updated")
  channel         Channel  @relation(fields: [channelId], references: [id])

  @@map("knowledge_base")
}

model Ticket {
  id             Int      @id @default(autoincrement())
  channelId      Int      @map("channel_id")
  customerNumber String   @map("customer_number")
  customerName   String?  @map("customer_name")
  status         String   @default("bot_handling")
  lastAgentId    Int?     @map("last_agent_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  channel        Channel  @relation(fields: [channelId], references: [id])
  lastAgent      SAAgent? @relation(fields: [lastAgentId], references: [id])

  @@map("tickets")
}

model ProductStock {
  id        Int     @id @default(autoincrement())
  channelId Int     @map("channel_id")
  productId String  @map("product_id")
  breed     String?
  sex       String?
  age       String?
  color     String?
  status    String  @default("disponible")
  channel   Channel @relation(fields: [channelId], references: [id])

  @@map("product_stock")
}

model PricingConfig {
  id               Int     @id @default(autoincrement())
  channelId        Int     @map("channel_id")
  cashPrice        Decimal @map("cash_price")
  listPrice        Decimal @map("list_price")
  minDeposit       Decimal @map("min_deposit")
  supportedQuotas  Int     @map("supported_quotas")
  approxInterest   Decimal @map("approx_interest")
  channel          Channel @relation(fields: [channelId], references: [id])

  @@map("pricing_configs")
}

model CompanyIdentity {
  id          Int     @id @default(autoincrement())
  channelId   Int     @unique @map("channel_id")
  mission     String? @db.Text
  vision      String? @db.Text
  brandManual String? @map("brand_manual") @db.Text
  voiceTone   String? @map("voice_tone")
  faqs        String? @db.Text
  channel     Channel @relation(fields: [channelId], references: [id])

  @@map("company_identities")
}

model LogisticsConfig {
  id             Int     @id @default(autoincrement())
  channelId      Int     @unique @map("channel_id")
  coverageZones  String? @map("coverage_zones") @db.Text
  deliveryTerms  String? @map("delivery_terms")
  daysAndHours   String? @map("days_and_hours")
  interiorCost   Decimal? @map("interior_cost")
  channel        Channel @relation(fields: [channelId], references: [id])

  @@map("logistics_configs")
}
