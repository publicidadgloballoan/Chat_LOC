# ============================================================
# SaaSIA — Meta Relay Server  —  Variables de Entorno
# ============================================================
# Copiar este archivo como .env y completar los valores

# Puerto del servidor relay
PORT=7010

# Token secreto para verificar el webhook en Meta Developer Dashboard
# DEBE coincidir exactamente con lo que ponés en:
#   Meta App → WhatsApp/Messenger/Instagram → Configuration → Webhook → Verify Token
META_VERIFY_TOKEN=SIA-META-VERIFY-2026

# Clave interna para autenticar instancias locales que conectan por WebSocket
# Debe coincidir con RELAY_API_KEY en meta_service local
RELAY_API_KEY=PICE-SAAS-DEFAULT-KEY-2026
